export DEPLOY_USER=your-ssh-user
export DEPLOY_HOST=your-server-host
# 服务器上的项目根目录（make deploy 用它拼远端路径；未设置时 deploy 会直接报错）
export DEPLOY_PATH=/path/on/server/xhan-helper
export XHAN_HELPER_DB_PASSWORD=your-mysql-password
# 语音聊天：新版火山控制台 API Key；开通「豆包语音合成模型2.0」和「豆包流式语音识别模型2.0」
# dev / prod 的 config 里 voice.enabled=true，缺这个 Key 后端会启动失败（fail-fast，不是静默降级）
export DOUBAO_VOICE_API_KEY=your-volcengine-speech-api-key
# 管理端用户 ID（config.dev/test 的 admin_users 引用；本地按需设置）
